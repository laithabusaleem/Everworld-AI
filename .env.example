# Server
HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=http://localhost:5173
# Relative to the server process cwd (apps/server when using npm workspaces)
DATABASE_PATH=./data/everworld.sqlite

# Model provider: "rules" (default, offline) or "openai" (OpenAI-compatible API)
MODEL_PROVIDER=rules

# Required only when MODEL_PROVIDER=openai
# Keys stay on the server — never expose them to the browser bundle.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenRouter / Groq / Gemini OpenAI-compatible endpoints also work
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.5-flash

REQUEST_TIMEOUT_MS=30000
